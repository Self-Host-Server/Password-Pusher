# Password Pusher - local environment overrides (not committed to git)

# Set this to your domain (with DNS pointing at this host) to enable
# automatic HTTPS/TLS via Let's Encrypt on port 443.
TLS_DOMAIN=

# PostgreSQL credentials, shared by the `postgres` service and pwpush's
# DATABASE_URL (see compose.yml). Change the password before deploying.
POSTGRES_USER=pwpush
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pwpush
